PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# AI Engine Preference: 'auto' | 'n8n' | 'gemini'
DEFAULT_ENGINE=auto

# Option 1: n8n Workflow (Chat Trigger or Webhook Trigger)
# ใส่ Webhook URL ของ n8n (Production หรือ Test URL)
N8N_WEBHOOK_URL=
# ใส่ API Key หาก Workflow กำหนด Header Authentication ไว้ (ไม่บังคับ)
N8N_API_KEY=

# Option 2: Google Gemini API (Standalone Direct Mode)
# สามารถรับ API Key ฟรีได้ที่ https://aistudio.google.com/
GEMINI_API_KEY=
# โมเดลแนะนำ: gemini-2.5-flash หรือ gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
